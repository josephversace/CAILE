<Project Sdk="Microsoft.NET.Sdk.Web">

	
	<PropertyGroup>
  <TargetFramework>net9.0</TargetFramework>
  <PublishAot>true</PublishAot>
  <InvariantGlobalization>true</InvariantGlobalization> <!-- if you don’t need ICU -->
  <StripSymbols>true</StripSymbols>
  <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata> <!-- keep minimal -->
  <IlcDisableUnsupportedWarnings>true</IlcDisableUnsupportedWarnings>
  <PublishTrimmed>true</PublishTrimmed>
  <OptimizationPreference>Speed</OptimizationPreference>
  <DebugType>none</DebugType>
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.*" />
</ItemGroup>

