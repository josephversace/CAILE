@inherits LayoutComponentBase
@using IIM.Shared.Models.Core
@using IIM.Shared.Interfaces
@using Microsoft.FluentUI.AspNetCore.Components

<div class="app-container">
    <!-- Sidebar Navigation Component -->
    <IIMSidebar SelectedWorkspaceId="@SelectedWorkspaceId"
                Workspaces="@Workspaces" 
                CurrentRoute="@CurrentRoute" />

    <!-- Main Content Area -->
    <main class="main-content">
        <!-- Top Navigation Bar -->
        <IIMTopBar SearchQuery="@SearchQuery"
                   OnSearchChanged="@OnSearchChanged"
                   OnExportClicked="@OnExportClicked"
                   OnIngestClicked="@OnIngestClicked" />

        <!-- Page Content -->
        <div class="content-wrapper">
            @Body
        </div>
    </main>

    <!-- AI Insights Panel (Global) -->
    <AIInsightsPanel Insights="@GlobalAIInsights" />
</div>

<!-- Global Dialogs -->
<FileIngestDialog @bind-IsVisible="@ShowIngestDialog"
                  OnFileIngested="@OnFileIngested" />

@code {
    // Layout state
    private string SelectedWorkspaceId = string.Empty;
    private string SearchQuery = string.Empty;
    private string CurrentRoute = string.Empty;
    private bool ShowIngestDialog = false;

    // Data
    private List<Workspace> Workspaces = new();
    private List<AIInsight> GlobalAIInsights = new();

    [Inject] private NavigationManager Navigation { get; set; } = default!;
  
    protected override async Task OnInitializedAsync()
    {
        CurrentRoute = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
        
        await LoadLayoutData();
    }

    private async Task LoadLayoutData()
    {
        // Load workspaces
        Workspaces = new List<Workspace>
        {
            new() { Id = Guid.NewGuid(), Name = "Case #2024-001 - Financial Fraud" },
            new() { Id = Guid.NewGuid(), Name = "Case #2024-002 - Cyber Security" },
            new() { Id = Guid.NewGuid(), Name = "Case #2024-003 - Data Breach" }
        };

        if (Workspaces.Any())
        {
            SelectedWorkspaceId = Workspaces.First().Id.ToString();
        }

        // Load global AI insights
        GlobalAIInsights = new List<AIInsight>
        {
            new("Detected unusual file access patterns in suspect_laptop.dd between 2:00-4:00 AM.", 87),
            new("Found 23 deleted files with recent timestamps. Recommend forensic recovery.", 94),
            new("Cross-reference phone_extraction.e01 with network_logs.json for timeline correlation.", 76)
        };
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentRoute = e.Location;
        StateHasChanged();
    }

    private void OnSearchChanged(string searchQuery)
    {
        SearchQuery = searchQuery;
        // Broadcast search to current page component
    }

    private void OnExportClicked()
    {
        // Handle global export
    }

    private void OnIngestClicked()
    {
        ShowIngestDialog = true;
    }

    private async Task OnFileIngested(VirtualFile file)
    {
        // Handle global file ingestion
        ShowIngestDialog = false;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

  

 
}