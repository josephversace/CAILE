    private void SubscribeToLayoutEvents()
    {
        // Subscribe to search events from the main layout
        // This would be implemented with a proper event service
    }

    private void HandleFolderSelection(SensitivityLevelData selectedLevel)
    {
        SelectedLevelName = selectedLevel.Name;
        CurrentlyDisplayedFiles = GetFilesForLevel(selectedLevel.Name);
        SelectedFile = null; // Deselect file when changing folders
        StateHasChanged();
    }

    private void HandleFileSelection(VirtualFile selectedFile)
    {
        SelectedFile = selectedFile;
        StateHasChanged();
    }

    /// <summary>
    /// Filters the master list of mock files to return only those
    /// matching the specified sensitivity level name.
    /// </summary>
    /// <param name="levelName">The name of the sensitivity level to filter by.</param>
    /// <returns>A list of FileData objects for the specified level.</returns>
    private List<VirtualFile> GetFilesForLevel(string levelName)
    {
        return Files.Where(f => f.ProposedSensitiviyLevel == levelName).ToList();
    }

    private void OnFileSelectionChanged(List<VirtualFile> selectedFiles)
    {
        SelectedFiles = selectedFiles;
        SelectedFile = selectedFiles.LastOrDefault();
        StateHasChanged();
    }

    private async Task OnFileDoubleClick(VirtualFile file)
    {
        // Implement file opening logic
        SelectedFile = file;
        if (!SelectedFiles.Contains(file))
        {
            SelectedFiles.Add(file);
        }
        StateHasChanged();
    }

    public void OnSearchChanged(string searchQuery)
    {
        SearchQuery = searchQuery;
        FilterFiles();
    }

    private void FilterFiles()
    {
        if (string.IsNullOrEmpty(SearchQuery))
        {
            FilteredFiles = Files.ToList();
        }
        else
        {
            FilteredFiles = Files.Where(f => f.FileName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        StateHasChanged();
    }
}