@page "/workspace-explorer"
@using IIM.Shared.Models.Core
@using IIM.Shared.Interfaces
@using Microsoft.FluentUI.AspNetCore.Components
@layout MainLayout


<PageTitle>File Explorer</PageTitle>

<div class="content-area">
    <div class="content-header">
        <h1 class="page-title">Evidence Files</h1>
        <p class="page-subtitle">Manage and analyze your files with AI-powered insights</p>
    </div>

    <div class="workspace-layout">

        <div class="main-content">

            <div class="sensitivity-folders-grid">
                @foreach (var level in AllLevelsInOrder)
                {
                    <SensitivityFolderCard Level="@level" OnClick="@HandleFolderSelection" />
                }
            </div>

            <div class="file-grid-container">
                <h3>Files in: @SelectedLevelName</h3>
                <FileGrid Files="@CurrentlyDisplayedFiles" OnFileDoubleClick="@HandleFileSelection" />
            </div>

        </div>

        <div class="details-panel">
            <DetailsSidePanel SelectedFile="@SelectedFile" />
        </div>

    </div>

    <div class="flex">

        <div>
    <!-- File Grid Component -->
    <FileGrid Files="@FilteredFiles"
              SelectedFiles="@SelectedFiles"
              OnFileSelectionChanged="@OnFileSelectionChanged"
              OnFileDoubleClick="@OnFileDoubleClick" />
        </div>
        <div>
            <!-- Chain of Custody Component -->
            @if (SelectedFile != null)
            {
                <ChainOfCustodyViewer File="@SelectedFile" />
            }
        </div>
  
    </div>
</div>

@code {
    // Data properties
    private List<VirtualFile> Files = new();
    private List<VirtualFile> FilteredFiles = new();
    private List<VirtualFile> SelectedFiles = new();
    private VirtualFile? SelectedFile;
    private string SearchQuery = string.Empty;

    private List<SensitivityLevelData> AllLevelsInOrder { get; set; } = new();
    private List<VirtualFile> CurrentlyDisplayedFiles { get; set; } = new();
 
    private string SelectedLevelName { get; set; } = "Quarantine";

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
        
        // Subscribe to layout search changes
        SubscribeToLayoutEvents();
    }

